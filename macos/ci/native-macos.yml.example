name: Native macOS client
on:
  pull_request:
    paths: ['macos/**', 'modules/menu/*.c', '.github/workflows/macos-client.yml']
  push:
    branches: ['codex/macos-native-client']
    paths: ['macos/**', 'modules/menu/*.c', '.github/workflows/macos-client.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build-and-test:
    runs-on: macos-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - name: Install dependencies
        run: brew install cmake pkgconf openssl@3 opus spandsp
      - name: Build app
        run: macos/scripts/build.sh
      - name: Test protocol bridge and local SIP signaling
        run: macos/scripts/test.sh
      - name: Package app
        run: ditto -c -k --sequesterRsrc --keepParent 'macos/dist/Baresip Mac.app' macos/dist/BaresipMac.zip
      - uses: actions/upload-artifact@v4
        with:
          name: BaresipMac-development
          path: macos/dist/BaresipMac.zip
